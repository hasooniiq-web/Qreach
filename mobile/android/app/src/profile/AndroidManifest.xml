<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Dev and test builds only (profile build type): lets the app reach a
         backend on the local network over plain http. The release manifest
         does not have this, so release builds stay HTTPS-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
